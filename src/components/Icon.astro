---
import { Icon as AstroIcon } from "astro-icon/components";

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "" } = Astro.props;

const icons: Record<string, string> = {
  advocacy: "tabler:speakerphone",
  bluesky: "tabler:brand-bluesky",
  book: "tabler:book-2",
  calendar: "tabler:calendar",
  check: "tabler:check",
  discord: "tabler:brand-discord",
  facebook: "tabler:brand-facebook",
  firstAid: "tabler:first-aid-kit",
  github: "tabler:brand-github",
  heart: "tabler:heart",
  instagram: "tabler:brand-instagram",
  link: "tabler:link",
  mail: "tabler:mail",
  moon: "tabler:moon",
  patreon: "tabler:brand-patreon",
  policy: "tabler:scale",
  shield: "tabler:shield-check",
  spark: "tabler:sparkles",
  sun: "tabler:sun",
  ticket: "tabler:ticket",
  users: "tabler:users-group",
};

const iconName = icons[name] ?? icons.spark;
---

<span class:list={["icon", className]} aria-hidden="true">
  <AstroIcon name={iconName} />
</span>
