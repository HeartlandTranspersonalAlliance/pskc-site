---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { site } from "../data/site";
import { stripBase, withBase } from "../utils/urls";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title,
  description = site.description,
  image = "/assets/images/PSKC%20FB_BANNER-01.jpeg",
  noIndex = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const siteOrigin = Astro.site ?? new URL(site.url);
const canonical = new URL(withBase(stripBase(Astro.url.pathname)), siteOrigin).toString();
const openGraphImage = new URL(withBase(image), siteOrigin).toString();
const pageTransition = {
  forwards: {
    old: {
      name: "pskc-page-exit",
      duration: "180ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
    new: {
      name: "pskc-page-enter",
      duration: "210ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
  },
  backwards: {
    old: {
      name: "pskc-page-exit",
      duration: "180ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
    new: {
      name: "pskc-page-enter",
      duration: "210ms",
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      fillMode: "both",
    },
  },
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={openGraphImage} />
    <link rel="icon" type="image/png" href={withBase("/assets/images/favicon-96x96.png")} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={withBase("/assets/images/favicon.svg")} />
    <link rel="shortcut icon" href={withBase("/assets/images/favicon.ico")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/assets/images/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("/assets/images/site.webmanifest")} />
    <ClientRouter fallback="animate" />
  </head>
  <body transition:animate={pageTransition} transition:name="page">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const selectors = [
          "main > section",
          ".hero-content > *",
          ".section-heading",
          ".feature-card",
          ".resource-card",
          ".news-card",
          ".contact-card",
          ".event-mini-card",
          ".event-list-card",
          ".tier-card",
          ".timeline-card",
          ".image-gallery figure",
          ".calendar-panel"
        ];

        let observer;

        const isInViewport = (target) => {
          const rect = target.getBoundingClientRect();
          return rect.top < window.innerHeight * 0.92 && rect.bottom > window.innerHeight * 0.08;
        };

        const reveal = () => {
          observer?.disconnect();
          if (reduceMotion.matches) return;
          const targets = Array.from(document.querySelectorAll(selectors.join(",")));
          targets.forEach((target, index) => {
            target.style.setProperty("--reveal-delay", `${Math.min(index, 6) * 100}ms`);
            if (isInViewport(target)) {
              target.setAttribute("data-revealed", "");
            } else {
              target.removeAttribute("data-revealed");
            }
            target.setAttribute("data-reveal", "");
          });
          if (!("IntersectionObserver" in window)) {
            targets.forEach((target) => target.setAttribute("data-revealed", ""));
            return;
          }
          observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.setAttribute("data-revealed", "");
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.18, rootMargin: "0px 0px -8% 0px" }
          );
          targets.forEach((target) => {
            observer.observe(target);
          });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", reveal, { once: true });
        } else {
          reveal();
        }
        document.addEventListener("astro:page-load", reveal);
      })();
    </script>
  </body>
</html>
