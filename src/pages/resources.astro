---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardGrid from "../components/CardGrid.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";
import Hero from "../components/Hero.astro";

const resources = [
  {
    category: "Integration",
    icon: "heart",
    title: "Kansas City Psychedelic Integration Circle",
    href: "https://kc-psychedelic.com",
    body: "A confidential Kansas City peer group for talking through psychedelic and other non-ordinary experiences.",
  },
  {
    category: "Advocacy & Education",
    icon: "advocacy",
    title: "Eleos Connect",
    href: "https://eleosconnect.com",
    body: "A Lee’s Summit nonprofit that educates the public and advocates for safe, affordable access to psychedelic-assisted therapy, including psilocybin.",
  },
  {
    category: "Peer Support",
    icon: "firstAid",
    title: "Fireside Project",
    href: "https://firesideproject.org",
    body: "A nonprofit with a free, confidential support line for psychedelic experiences. It also offers integration coaching.",
  },
  {
    category: "Harm reduction",
    icon: "heart",
    title: "Safe Journey Sanctum",
    href: "https://safejourneysanctum.org",
    body: "A Heartland Transpersonal Alliance program that offers peer support and harm reduction education at events.",
  },
];
---

<BaseLayout
  editorial
  title="Resources"
  description="Find a Kansas City integration group, local advocacy, and peer support for psychedelic experiences."
>
  <Hero
    compact
    titleLines={["Psychedelic resources"]}
    intro="Find a local integration group, learn about advocacy in Missouri, or talk to a trained peer."
    image="/assets/images/kcpcbanner.jpg"
    imageAlt="Abstract KCPC mandala artwork used for PSKC resource pages"
  />

  <Section>
    <CardGrid columns="two">
      {resources.map((resource) => (
        <article class="resource-card">
          <div class="resource-card__header">
            <div class="card-icon">
              <Icon name={resource.icon} />
            </div>
            <div>
              <p class="eyebrow">{resource.category}</p>
              <h2>{resource.title}</h2>
            </div>
          </div>
          <p>{resource.body}</p>
          <a class="resource-card__link" href={resource.href} target="_blank" rel="noopener noreferrer">
            Visit {resource.title}
          </a>
        </article>
      ))}
    </CardGrid>
  </Section>
</BaseLayout>
