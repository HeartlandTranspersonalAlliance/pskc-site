---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import CardGrid from "../components/CardGrid.astro";
import ImageGallery from "../components/ImageGallery.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";
import Hero from "../components/Hero.astro";
import { withBase } from "../utils/urls";

const visionarySponsors = [
  {
    href: "https://alicecbd.com/",
    src: "/assets/images/kcpc/alicecbd.jpg",
    alt: "alice RN Nutraceutical logo",
    title:
      "aliceCBD and alice RN Nutraceutical specialize in products that use cannabinoids and terpenes that are federally legal equal to or less than 0.3% THC Delta 9, including CBD, THC-V, CBG, BCP, THC-P, CBD-P, and Delta-8.",
  },
];

const trailblazerSponsors = [
  {
    href: "https://www.hummingbirdhealthcare.com/",
    src: "/assets/images/kcpc/hummingbird.jpg",
    alt: "Hummingbird Healthcare logo",
    title: "Hummingbird Healthcare",
  },
  {
    href: "https://www.evolution-mag.com/",
    src: "/assets/images/kcpc/evolution.jpg",
    alt: "The Evolution Magazine logo",
    title: "Evolution Magazine",
  },
];

const exploreItems = [
  {
    icon: "book",
    title: "Advancements in psychedelic science",
    body: "Clinical models, mechanisms of action, genetics, nutrition, and safety considerations across the MIND track.",
  },
  {
    icon: "heart",
    title: "Integration and harm reduction",
    body: "Panels and talks centered on peer support, practical risk reduction, and equitable access to psychedelic care.",
  },
  {
    icon: "policy",
    title: "Missouri policy efforts",
    body: "Local and statewide policy conversations about compassionate, evidence-aware approaches to drug use and care.",
  },
  {
    icon: "spark",
    title: "Embodied practice",
    body: "Workshops including ecstatic dance, meditation, yoga, authentic relating, cacao, breathwork, and movement.",
  },
];

const mindSchedule = [
  { time: "9:00 AM - 9:45 AM", title: "Doors Open" },
  { time: "9:45 AM - 10:00 AM", title: "Opening Remarks and Ceremony", note: "Presented by Mooncat and Twinnflame" },
  { time: "10:00 AM - 10:30 AM", title: "The Medical Model: Set, Setting, and Soul in Clinical Practice", note: "Presented by Dr. Shawn Lillig" },
  { time: "10:30 AM - 11:00 AM", title: "Connection, Not Competition: The Inner Cannabis System", note: "Presented by Alice Mangan" },
  { time: "11:00 AM - 11:15 AM", title: "Healing for All: Building Equitable Access to Psychedelic Care", note: "Presented by Crystal Sudduth" },
  { time: "11:15 AM - 12:00 PM", title: "Harm Reduction Panel", note: "Presented by Carolyn Shane, April Hatch, Tanto G., and Dale Morgan" },
  { time: "12:00 PM - 1:00 PM", title: "Lunch Break" },
  { time: "1:00 PM - 1:05 PM", title: "Welcome Back Remarks", note: "Presented by Mooncat" },
  { time: "1:05 PM - 1:20 PM", title: "Psychedelic Politics in Missouri", note: "Presented by Eapen Thampy" },
  { time: "1:20 PM - 1:35 PM", title: "Medicine for Our Protectors: Medicine for Society", note: "Presented by Walter Disney" },
  { time: "1:35 PM - 2:05 PM", title: "Set, Setting, and Salad? Why Nutrition Matters in Psychedelic Work", note: "Presented by Elizabeth-Jane Oatz" },
  { time: "2:05 PM - 2:20 PM", title: "Break" },
  { time: "2:20 PM - 2:50 PM", title: "Psychedelics and Their Mechanisms of Action and an Exploration of Known Potential Medicinal Value", note: "Presented by Matthew Taylor" },
  { time: "2:50 PM - 3:20 PM", title: "Genes, Enzymes, and Entheogens: The Role of Genetic Testing in Psychedelic Safety and Efficacy", note: "Presented by Rhy Norton" },
  { time: "3:20 PM - 3:30 PM", title: "Break" },
  { time: "3:30 PM - 4:00 PM", title: "Entheogenic Circles: A Model for Community-Led Psychedelic Practice", note: "Presented by Beth Day and Joseph Hood" },
  { time: "4:00 PM - 4:45 PM", title: "Integration Panel", note: "Presented by Ian Cook, Marisa Frazier, Stephanie Zamora, and Dr. Christine Mooncat Ziemer" },
  { time: "4:45 PM - 5:00 PM", title: "Closing Remarks and Ceremony", note: "Presented by Mooncat and Twinnflame" },
];

const bodySchedule = [
  { time: "9:45 AM - 10:00 AM", title: "Opening Remarks and Ceremony", note: "Presented by Mooncat and Twinnflame in the speaker room" },
  { time: "10:00 AM - 10:30 AM", title: "Mini Ecstatic Dance Experience", note: "With Jenny Severo and DJ Clandestine" },
  { time: "10:30 AM - 11:00 AM", title: "Meditative Movement with Flow Props", note: "With Laura Lockton" },
  { time: "11:00 AM - 11:30 AM", title: "Laughter Yoga", note: "With Shawn Lillig" },
  { time: "11:30 AM - 12:00 PM", title: "Ayahuasca and Other Plant Medicines of The Amazon", note: "With Matt Brake" },
  { time: "12:00 PM - 1:00 PM", title: "Lunch Break" },
  { time: "1:00 PM - 1:45 PM", title: "Authentic Relating", note: "With Cameryn Lamare" },
  { time: "1:45 PM - 2:30 PM", title: "Cacao: The Portal to The Heart", note: "With Rukmani Kaur" },
  { time: "2:30 PM - 3:00 PM", title: "Accessing Altered States Through Breathwork", note: "With Stephanie Zamora" },
  { time: "3:00 PM - 3:15 PM", title: "Break" },
  { time: "3:15 PM - 4:00 PM", title: "Stacking Modalities to Enhance Healing Before, During, and After a Psychedelic Experience", note: "With Dawn Birdsong and Mindy Thomas" },
  { time: "4:00 PM - 4:30 PM", title: "From Mystical States to Intentional Living: Integrating the Psychedelic Experience through Meditation", note: "With Tim Ely" },
  { time: "4:45 PM - 5:00 PM", title: "Closing Remarks and Ceremony", note: "Presented by Mooncat and Twinnflame in the speaker room" },
];

const tracks = [
  { title: "MIND Track", icon: "book", items: mindSchedule },
  { title: "BODY Track", icon: "spark", items: bodySchedule },
];

const kcpc2025Gallery = [
  {
    src: "/assets/images/kcpc2025/kcpc-2025-03.jpg",
    alt: "KCPC 2025 attendees gathered in conversation",
    title: "Connection in every room",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-07.jpg",
    alt: "Attendees moving together during a KCPC 2025 workshop",
    title: "Movement and play",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-10.jpg",
    alt: "Audience gathered for a talk at KCPC 2025",
    title: "A room full of questions",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-15.jpg",
    alt: "Panelists speaking on stage at KCPC 2025",
    title: "Learning together",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-19.jpg",
    alt: "Attendees resting during a guided KCPC 2025 workshop",
    title: "Space to slow down",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-21.jpg",
    alt: "KCPC 2025 integration panel on stage",
    title: "Many perspectives, one community",
  },
];
---

<BaseLayout
  title="Kansas City Psychedelic Conference"
  description="Kansas City Psychedelic Conference 2026: Frontiers in Consciousness, November 21 at the Zhou B Art Center in Kansas City, featuring Dr. Rick Strassman, author of DMT: The Spirit Molecule."
>
  <Hero
    eyebrow="KCPC 2026 · Frontiers in Consciousness"
    titleLines={["Kansas City", "Psychedelic", "Conference"]}
    intro="A full day exploring the evolving edges of psychedelic science, consciousness, healing, spirituality, and transpersonal experience with Dr. Rick Strassman."
    image="/assets/images/kcpc2025/kcpc-2025-14.jpg"
    imageAlt="Audience listening to a speaker at the 2025 Kansas City Psychedelic Conference"
  >
    <Button slot="actions" href="https://luma.com/rfkhxamw" variant="primary">Buy tickets</Button>
    <Button slot="actions" href="#event-details" variant="secondary">Event details</Button>
    <Button slot="actions" href="https://forms.gle/uPzrdhrb62ZEaLwD7" variant="secondary">Volunteer</Button>
  </Hero>

  <Section id="event-details" tone="mist" eyebrow="Announcing KCPC 2026" title="🌌 Frontiers in Consciousness 🌌" intro="Meet us Saturday, November 21, 2026, from 9:00 AM to 5:00 PM at the Zhou B Art Center in Kansas City, MO.">
    <CardGrid columns="four">
      <article class="feature-card conference-topic">
        <p class="eyebrow">When</p>
        <h3>9:00 AM–5:00 PM</h3>
        <p>Saturday, November 21, 2026.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">Where</p>
        <h3>Zhou B Art Center</h3>
        <p>Join the Kansas City psychedelic community in an art-filled setting in Kansas City, Missouri.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">Featured guest</p>
        <h3>Rick Strassman</h3>
        <p>Author of <em>DMT: The Spirit Molecule</em>.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">VIP experience</p>
        <h3>After party access</h3>
        <p>VIP tickets include access to the KCPC 2026 after party.</p>
      </article>
    </CardGrid>
    <div class="kcpc-cta-strip">
      <div>
        <p class="eyebrow">Tickets</p>
        <p>Tickets are available now. Join us as we explore the Frontiers in Consciousness together.</p>
      </div>
      <Button href="https://luma.com/rfkhxamw" variant="primary">Get tickets</Button>
    </div>
  </Section>

  <Section eyebrow="The 2026 theme" title="Exploring what lies beyond the known.">
    <div class="prose-site max-w-none">
      <p>The Psychedelic Society of Kansas City is thrilled to announce the theme of this year’s Kansas City Psychedelic Conference 2026: <strong>Frontiers in Consciousness</strong>.</p>
      <p>We cannot think of anyone better suited to help us explore that theme than our 2026 keynote speaker: <strong>Dr. Rick Strassman</strong>.</p>
      <p>A pioneering psychedelic researcher and author of <em>DMT: The Spirit Molecule</em>, Dr. Strassman helped reopen the door to human psychedelic research in the United States after decades of dormancy. Beginning his groundbreaking DMT studies at the University of New Mexico in the early 1990s, his work ventured into territory that was scientifically, professionally, and culturally difficult to explore at the time.</p>
      <p>In many ways, Dr. Strassman was exploring the frontiers of consciousness long before today’s psychedelic renaissance began.</p>
      <p>This November, we’re bringing that spirit of exploration to Kansas City.</p>
      <p><strong>Frontiers in Consciousness</strong> will invite us to look beyond what we already know and explore the evolving edges of psychedelic science, consciousness, healing, spirituality, and transpersonal experience. Through research, education, conversation, and community, we’ll ask what lies at the boundaries of our current understanding—and what might be waiting beyond them.</p>
      <p>We are incredibly excited to welcome Dr. Rick Strassman to Kansas City to help lead that exploration.</p>
    </div>
  </Section>

  <Section eyebrow="KCPC 2025 · In pictures" title="This is what last year felt like." intro="From packed talks to movement, integration, and hallway conversations, the 2025 gathering made room for many ways to participate."
  >
    <ImageGallery images={kcpc2025Gallery} columns="three" />
  </Section>

  <Section eyebrow="Get involved" title="Find your way into KCPC 2026.">
    <div class="kcpc-cta-strip">
      <div>
        <p class="eyebrow">Volunteer with us</p>
        <p>This conference would not have been possible last year without our wonderful volunteers. We’re eternally grateful to anyone who donates their time, resources, or skills to help foster and grow Kansas City’s ever-expanding psychedelic community.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href="https://forms.gle/uPzrdhrb62ZEaLwD7" variant="primary">Volunteer form</Button>
        <Button href="https://luma.com/rfkhxamw" variant="secondary">Buy tickets</Button>
      </div>
    </div>

    <CardGrid columns="four">
      {exploreItems.map((item) => (
        <article class="feature-card conference-topic">
          <div class="card-icon">
            <Icon name={item.icon} />
          </div>
          <p class="eyebrow">KCPC</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </CardGrid>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="https://docs.google.com/forms/d/1arXwo043GzglzVz6K3WAG4Ka8xV9eAXh1uDiL8GkXw4/edit?usp=drivesdk" variant="secondary">Speaker & Presenter Application</Button>
      <Button href="https://docs.google.com/forms/d/1PZUCp2RBuPI0S_-Z9KzcsKH_P2sIAXYKfXRJ2BZFaok/edit?usp=drivesdk" variant="secondary">Sponsor & Vendor Application</Button>
    </div>
  </Section>

  <Section tone="mist" eyebrow="Returning in 2026" title="MIND and BODY tracks return" intro="The 2026 program will feature the return of our MIND and BODY tracks. MIND focuses on lectures, panels, and stimulating conversations. BODY focuses on somatic modalities, meditation, kinetic dance, and ceremonies.">
    <p class="mb-8 max-w-3xl text-lg text-[var(--ink)]/75">The session lineup below previews the track format from KCPC 2025. Detailed 2026 session times and presenters will be announced soon.</p>
    <div class="schedule-grid">
      {tracks.map((track) => (
        <article class="schedule-track">
          <div class="schedule-track__header">
            <h3>{track.title}</h3>
            <Icon name={track.icon} />
          </div>
          <div class="schedule-list">
            {track.items.map((item) => (
              <div class="schedule-item">
                <div class="schedule-time">{item.time}</div>
                <div>
                  <div class="schedule-title">{item.title}</div>
                  {item.note && <div class="schedule-note">{item.note}</div>}
                </div>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
    <div class="schedule-downloads">
      <a class="button button--secondary" href={withBase("/assets/images/kcpc/mind.jpg")} download>
        Download MIND schedule image
      </a>
      <a class="button button--secondary" href={withBase("/assets/images/kcpc/body.jpg")} download>
        Download BODY schedule image
      </a>
      <a class="button button--secondary" href={withBase("/assets/calendar/kcpc-2025-mind-example.ics")} download>
        Download example MIND calendar
      </a>
      <a class="button button--secondary" href={withBase("/assets/calendar/kcpc-2025-body-example.ics")} download>
        Download example BODY calendar
      </a>
    </div>
  </Section>

  <Section eyebrow="Special Thanks" title="KCPC sponsors make this possible.">
    <div class="space-y-12">
      <div>
        <h2 class="sponsor-heading">Visionary Sponsor</h2>
        <ImageGallery images={visionarySponsors} columns="three" variant="logo" />
      </div>
      <div>
        <h2 class="sponsor-heading">Trailblazer Sponsors</h2>
        <ImageGallery images={trailblazerSponsors} variant="logo" />
      </div>
    </div>
  </Section>

  <Section tone="ink" eyebrow="Help Out" title="Volunteers, sponsors, and vendors">
    <div class="split-band">
      <p class="text-xl leading-relaxed text-[var(--paper)]/85">
        There are many ways to help make KCPC 2026 possible. Volunteer your time, share your skills, present your work, or join us as a sponsor or vendor.
      </p>
      <div class="flex flex-wrap gap-3">
        <Button href="https://forms.gle/uPzrdhrb62ZEaLwD7" variant="primary">Volunteer form</Button>
        <Button href="https://docs.google.com/forms/d/1arXwo043GzglzVz6K3WAG4Ka8xV9eAXh1uDiL8GkXw4/edit?usp=drivesdk" variant="outline">Presenter form</Button>
        <Button href="https://docs.google.com/forms/d/1PZUCp2RBuPI0S_-Z9KzcsKH_P2sIAXYKfXRJ2BZFaok/edit?usp=drivesdk" variant="outline">Sponsor & Vendor</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
