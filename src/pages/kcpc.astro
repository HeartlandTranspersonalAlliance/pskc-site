---
import ChiefsRaffle from "../components/ChiefsRaffle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import CardGrid from "../components/CardGrid.astro";
import ImageGallery from "../components/ImageGallery.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";
import Hero from "../components/Hero.astro";
import { withBase } from "../utils/urls";

const afterPartySponsors = [
  {
    href: "https://www.evolution-mag.com/",
    src: "/assets/images/kcpc/evolution.jpg",
    alt: "The Evolution Magazine logo",
    title: "Evolution Magazine",
  },
];

const trailblazerSponsors = [
  {
    src: "/assets/images/kcpc/midwest-psychedelic.svg",
    alt: "Midwest Psychedelic logo",
    title: "Midwest Psychedelic",
  },
  {
    src: "/assets/images/kcpc/psilly-goose.png",
    alt: "Psilly Goose logo",
    title: "Psilly Goose",
  },
  {
    src: "/assets/images/kcpc/hummingbird-healthcare.png",
    alt: "Hummingbird Healthcare logo",
    title: "Hummingbird Healthcare",
  },
];

const programFocusItems = [
  {
    icon: "book",
    title: "Psychedelic research",
    body: "Sessions on DMT, ayahuasca, microdosing and ketamine-assisted psychotherapy.",
  },
  {
    icon: "heart",
    title: "Integration and harm reduction",
    body: "Panels on community integration and psychedelic education as harm reduction.",
  },
  {
    icon: "policy",
    title: "Missouri policy and access",
    body: "Talks on the legal status of psychedelics and Missouri’s 2027 legislative efforts.",
  },
  {
    icon: "spark",
    title: "Breathwork and movement",
    body: "Breathwork, qigong, authentic relating and ecstatic dance in the Body Room.",
  },
];

const kcpc2025Gallery = [
  {
    src: "/assets/images/kcpc2025/kcpc-2025-16.jpg",
    alt: "KCPC 2025 exhibitor table with handmade jewelry and community materials",
    title: "Community exhibits",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-07.jpg",
    alt: "Attendees moving together during a KCPC 2025 workshop",
    title: "Movement workshop",
    description: "Participants in a group movement session.",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-09.jpg",
    alt: "KCPC 2025 attendees connecting near community tables",
    title: "Community tables",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-12.jpg",
    alt: "KCPC 2025 vendor displaying handmade jewelry and goods",
    title: "Vendor exhibits",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-18.jpg",
    alt: "Audience seated for a presentation at KCPC 2025",
    title: "Audience at a presentation",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-19.jpg",
    alt: "KCPC 2025 attendees resting on cushions during a guided session",
    title: "Guided workshop",
  },
];
---

<BaseLayout
  editorial
  title="Kansas City Psychedelic Conference 2026"
  description="Kansas City Psychedelic Conference 2026: Frontiers in Consciousness, November 21 at the Zhou B Art Center in Kansas City, with a live teleconference keynote by Dr. Rick Strassman, author of DMT: The Spirit Molecule."
>
  <Hero
    eyebrow="KCPC 2026 · Frontiers in Consciousness"
    titleLines={["Kansas City", "Psychedelic", "Conference"]}
    intro="Talks and workshops on psychedelic research, policy and integration, with a live teleconference keynote by Dr. Rick Strassman."
    image="/assets/images/kcpc2025/kcpc-2025-14.jpg"
    imageAlt="Audience listening to a speaker at the 2025 Kansas City Psychedelic Conference"
  >
    <Button slot="actions" href="https://luma.com/rfkhxamw" variant="primary">Buy tickets</Button>
    <Button slot="actions" href="#event-details" variant="secondary">Event details</Button>
    <Button slot="actions" href="https://forms.gle/uPzrdhrb62ZEaLwD7" variant="secondary">Volunteer</Button>
  </Hero>

  <Section id="event-details" tone="mist" eyebrow="Event details" title="Saturday, November 21, 2026" intro="Zhou B Art Center · Kansas City, MO · Doors 8:00 AM · Program 9:00 AM–6:30 PM Central">
    <CardGrid columns="four">
      <article class="feature-card conference-topic">
        <p class="eyebrow">When</p>
        <h3>9:00 AM–6:30 PM</h3>
        <p>Doors and registration open at 8:00 AM.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">Where</p>
        <h3>Zhou B Art Center</h3>
        <p>Kansas City, Missouri.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">Keynote</p>
        <h3>Dr. Rick Strassman</h3>
        <p>Author of <em>DMT: The Spirit Molecule</em>.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">After-party · 21+</p>
        <h3>Free with a conference badge</h3>
        <p>VIP ticket holders also get a complimentary noodle bowl from Food by KayFan.</p>
      </article>
    </CardGrid>
    <div class="venue-photos" aria-label="Zhou B Art Center venue photos">
      <figure class="venue-photos__exterior">
        <img src={withBase('/assets/images/kcpc/zhou-b-exterior.webp')} width="1200" height="800" loading="lazy" decoding="async" alt="Zhou B Art Center’s glass entrance with its name above the doors, surrounded by red brick walls." />
        <figcaption>Zhou B Art Center entrance</figcaption>
      </figure>
      <figure class="venue-photos__gallery">
        <img src={withBase('/assets/images/kcpc/zhou-b-gallery.webp')} width="387" height="516" loading="lazy" decoding="async" alt="Inside Zhou B Art Center: paintings on freestanding white panels beside tall windows and a sunlit wooden floor." />
        <figcaption>Inside the art gallery</figcaption>
      </figure>
    </div>
    <div class="kcpc-cta-strip">
      <div>
        <p class="eyebrow">Tickets</p>
      </div>
      <Button href="https://luma.com/rfkhxamw" variant="primary">Buy tickets</Button>
    </div>
  </Section>

  <Section id="schedule" tone="mist" eyebrow="KCPC 2026 Schedule" title="Conference schedule." intro="Saturday, November 21 · Doors and registration at 8:00 AM · Program 9:00 AM–6:30 PM">
    <p class="schedule-hint">Choose Mind or Body to open the full schedule.</p>
    <div class="schedule-collage">
      {['mind', 'body'].map((track, index) => (
        <a class="schedule-thumbnail" data-schedule-index={index} data-gallery-title={`${track.toUpperCase()} schedule`} href={withBase(`/assets/images/kcpc/schedule-${track}-2026.webp`)} aria-haspopup="dialog" aria-label={`View ${track.toUpperCase()} schedule in gallery`}>
          <img src={withBase(`/assets/images/kcpc/schedule-${track}-2026-thumb.webp`)} width="400" height="533" loading="lazy" alt={`KCPC 2026 ${track.toUpperCase()} schedule`} />
          <span>{track.toUpperCase()} <span>View</span></span>
        </a>
      ))}
    </div>
    <details class="schedule-transcript">
      <summary>Read the text-only schedule</summary>
      <h3>MIND track</h3>
      <ol class="conference-schedule__text">
            <li><strong>8:00 AM</strong><span>Doors open and registration begins</span></li>
            <li><strong>9:00–9:10 AM</strong><span>Opening Ceremony &amp; Soundbath — Omno &amp; Mooncat</span></li>
            <li><strong>9:10–9:40 AM</strong><span>The Sacred Practice of Microdosing: A Foundational Guide — Melissa Saubers</span></li>
            <li><strong>9:45–10:25 AM</strong><span>Personal Testimony: The Power of Our Stories — Jay Copes &amp; Kim Taylor</span></li>
            <li><strong>10:25–10:35 AM</strong><span>Break</span></li>
            <li><strong>10:35–11:05 AM</strong><span>Ayahuasca: Bridging Science, Tradition, &amp; Spirit — Matt Brake</span></li>
            <li><strong>11:10 AM–12:00 PM</strong><span>Ketamine Assisted Psychotherapy: Hope, Agency, &amp; Motivation for Change — Katja Cahoon, Amanda DiMartini &amp; Liz Wells</span></li>
            <li><strong>12:00–1:00 PM</strong><span>Lunch break</span></li>
            <li><strong>1:00–1:05 PM</strong><span>Welcome Back Remarks — Mooncat</span></li>
            <li><strong>1:05–2:25 PM</strong><span>The Long Strange Trip (keynote) — Dr. Rick Strassman (live via teleconference)</span></li>
            <li><strong>2:25–2:35 PM</strong><span>Break</span></li>
            <li><strong>2:35–3:15 PM</strong><span>Controlled Substances…Sort Of: The Legal Status of Psychedelics — Shawn Lee</span></li>
            <li><strong>3:20–3:30 PM</strong><span>Update on 2027 Psychedelic Legislature in Missouri — Dena Ladd (MHC)</span></li>
            <li><strong>3:35–4:15 PM</strong><span>Psychedelics, Art &amp; the Creative Process — Haley Fox, Kyle Yarber, Ian Cook &amp; JAntho CHO</span></li>
            <li><strong>4:20–4:50 PM</strong><span>Sacred Animal Venoms: Psychedelics &amp; Beyond — Sincere Seven Genesis</span></li>
            <li><strong>4:50–5:00 PM</strong><span>Break</span></li>
            <li><strong>5:00–5:40 PM</strong><span>The Role of Community in Psychedelic Integration — Carrie McDaniel, Elizabeth J.O. &amp; Sincere Seven Genesis</span></li>
            <li><strong>5:45–6:25 PM</strong><span>Psychedelic Education is Harm Reduction — Dale Morgan, Mooncat, Trina DuVall &amp; Harmony MindzEye</span></li>
            <li><strong>6:25–6:30 PM</strong><span>Closing Remarks &amp; Ceremony — Omno &amp; Mooncat</span></li>
          </ol>
      <h3>BODY track</h3>
      <ol class="conference-schedule__text">
            <li><strong>9:00–9:10 AM</strong><span>Opening Ceremony &amp; Soundbath — Omno &amp; Mooncat, in the MIND Room</span></li>
            <li><strong>9:10–9:40 AM</strong><span>Stretch &amp; Sound — Shawn Lillig</span></li>
            <li><strong>9:45–10:25 AM</strong><span>Breathe Life – 9D Breathwork: A Psychedelic Journey Through Breath &amp; Sound — Harmony MindzEye</span></li>
            <li><strong>10:25–10:35 AM</strong><span>Break</span></li>
            <li><strong>10:35–11:05 AM</strong><span>Dreamwork &amp; Psychedelics Toward Soul Encounter — Dreamer Jaime Prieto</span></li>
            <li><strong>11:10 AM–12:00 PM</strong><span>Qigong: A Moving Meditation for Balance, Energy &amp; Inner Connection — Marisa Frazier</span></li>
            <li><strong>12:00–1:00 PM</strong><span>Lunch break</span></li>
            <li><strong>1:00–1:05 PM</strong><span>Welcome Back Remarks — Mooncat, in the MIND Room</span></li>
            <li><strong>1:05–2:25 PM</strong><span>The Long Strange Trip (keynote) — Dr. Rick Strassman (live via teleconference, shown in the Mind Room)</span></li>
            <li><strong>2:25–2:35 PM</strong><span>Break</span></li>
            <li><strong>2:35–3:30 PM</strong><span>Accessing Altered States of Consciousness with Breathwork — Stephanie Zamora</span></li>
            <li><strong>3:35–4:50 PM</strong><span>Authentic Relating — Cameryn Lamare</span></li>
            <li><strong>4:50–5:00 PM</strong><span>Break</span></li>
            <li><strong>5:00–6:25 PM</strong><span>Ecstatic Dance — Jenny Severo &amp; DJ Clandestine</span></li>
            <li><strong>6:25–6:30 PM</strong><span>Closing Remarks &amp; Ceremony — Omno &amp; Mooncat, in the MIND Room</span></li>
          </ol>
    </details>
    <dialog id="schedule-gallery" aria-labelledby="schedule-gallery-title">
      <div class="schedule-gallery__toolbar">
        <h2 id="schedule-gallery-title" aria-live="polite">MIND schedule</h2>
        <button type="button" data-gallery-close autofocus aria-label="Close image preview">Close ×</button>
      </div>
      <div class="schedule-gallery__controls" aria-label="Choose schedule">
        <button type="button" data-gallery-track="0" aria-pressed="true">MIND</button>
        <button type="button" data-gallery-track="1" aria-pressed="false">BODY</button>
        <a data-gallery-full href={withBase('/assets/images/kcpc/schedule-mind-2026.webp')} target="_blank" rel="noopener">Open full-size</a>
      </div>
      <img data-gallery-image alt="" />
    </dialog>
  </Section>

  <Section id="event-map" title="Conference map" intro="Check in by the entrance, then use the map’s yellow arrows to find the Mind and Body rooms. Vendor booths and Safe Journey Sanctum are in the Community Space.">
    <a class="schedule-thumbnail kcpc-image-card" data-gallery-title="Conference map" data-gallery-wide href={withBase('/assets/images/kcpc/event-map-2026-hd.webp')} aria-haspopup="dialog" aria-label="Enlarge the KCPC 2026 conference map">
      <img src={withBase('/assets/images/kcpc/event-map-2026-hd-thumb.webp')} width="420" height="325" loading="lazy" alt="KCPC 2026 conference map showing registration, the Mind and Body rooms, and vendor booths" />
      <span>Conference map <span>View map</span></span>
    </a>
  </Section>

  <Section id="after-party" title="KCPC 2026 after-party" intro="Saturday, November 21 at 8:00 PM · In The Lowest Ferns, 1105 Hickory St., Kansas City, MO · 21+">
    <p class="kcpc-afterparty-details">Free with a conference badge. VIP ticket holders also get a complimentary noodle bowl from Food by KayFan.</p>
    <a class="schedule-thumbnail kcpc-image-card kcpc-image-card--flyer" data-gallery-title="KCPC 2026 after-party flyer" href={withBase('/assets/images/kcpc/after-party-2026-hd.webp')} aria-haspopup="dialog" aria-label="Enlarge the KCPC 2026 after-party flyer">
      <img src={withBase('/assets/images/kcpc/after-party-2026-hd-thumb.webp')} width="340" height="440" loading="lazy" alt="KCPC 2026 after-party flyer for In The Lowest Ferns" />
      <span>After-party flyer <span>View flyer</span></span>
    </a>
  </Section>

  <Section tone="paper" eyebrow="Program focus" title="What’s on the program.">
    <CardGrid columns="four">
      {programFocusItems.map((item) => (
        <article class="feature-card conference-topic">
          <div class="card-icon">
            <Icon name={item.icon} />
          </div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </CardGrid>
  </Section>



  <Section tone="ink" eyebrow="2026 theme" title="Frontiers in Consciousness">
    <CardGrid columns="three">
      <article class="feature-card conference-topic">
        <p class="eyebrow">Research</p>
        <h3>Psychedelic science</h3>
        <p>Hear about psychedelic research and its applications in clinical practice.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">The conversation</p>
        <h3>Science, healing, and spirituality</h3>
        <p>Speakers discuss research alongside personal experience and spiritual practice.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">The format</p>
        <h3>Mind and Body tracks</h3>
        <p>The Mind Room hosts talks and panels. The Body Room hosts movement and experiential sessions. Both tracks join in the Mind Room for the keynote and opening and closing ceremonies.</p>
      </article>
    </CardGrid>
  </Section>

  <Section eyebrow="Keynote speaker" title="Dr. Rick Strassman" intro="DMT researcher and author of DMT: The Spirit Molecule.">
    <div class="split-band">
      <div>
        <p class="eyebrow">Research and writing</p>
        <p class="text-xl leading-relaxed">Dr. Strassman studied DMT at the University of New Mexico in the early 1990s. He later wrote <em>DMT: The Spirit Molecule</em> about that research.</p>
      </div>
      <div>
        <p class="eyebrow">On the program</p>
        <p class="text-xl leading-relaxed">Dr. Strassman will present “The Long Strange Trip” live via teleconference from 1:05 to 2:25 PM Central. Attendees can watch the keynote together in the Mind Room. The conference also includes psychedelic art, a gallery and a raffle.</p>
      </div>
    </div>
  </Section>

  <Section eyebrow="KCPC 2025" title="Photos from KCPC 2025." intro="A look at last year’s workshops, speakers and community tables."
  >
    <ImageGallery images={kcpc2025Gallery} columns="three" />
  </Section>

  <Section eyebrow="Get involved" title="Get involved with KCPC." intro="Volunteer or support the event as a sponsor or vendor.">
    <CardGrid columns="two">
      <article class="feature-card conference-topic">
        <p class="eyebrow">Volunteer</p>
        <h3>Volunteer with us</h3>
        <p>Help the KCPC team run the conference. Tell us about your interests and availability.</p>
        <Button href="https://forms.gle/uPzrdhrb62ZEaLwD7" variant="secondary">Volunteer form</Button>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">Sponsor and vendor</p>
        <h3>Sponsor or exhibit at KCPC</h3>
        <p>Apply to support the conference as a sponsor or take part as a vendor.</p>
        <Button href="https://docs.google.com/forms/d/1PZUCp2RBuPI0S_-Z9KzcsKH_P2sIAXYKfXRJ2BZFaok/edit?usp=drivesdk" variant="secondary">Sponsor/vendor application</Button>
      </article>
    </CardGrid>
  </Section>



  <Section eyebrow="Our sponsors" title="Thank you to our sponsors.">
    <div class="space-y-12">
      <div>
        <h2 class="sponsor-heading">KCPC 2026 Trailblazer Sponsors</h2>
        <ImageGallery images={trailblazerSponsors} columns="three" variant="logo" />
      </div>
      <div>
        <h2 class="sponsor-heading">KCPC 2026 After Party Sponsor</h2>
        <ImageGallery images={afterPartySponsors} variant="logo" />
      </div>
    </div>
  </Section>

  <ChiefsRaffle />
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#schedule-gallery');
  const triggers = [...document.querySelectorAll<HTMLAnchorElement>('[data-gallery-title]')];
  const thumbnails = triggers.filter((link) => link.hasAttribute('data-schedule-index'));
  if (dialog && typeof dialog.showModal === 'function') {
    const image = dialog.querySelector<HTMLImageElement>('[data-gallery-image]')!;
    const full = dialog.querySelector<HTMLAnchorElement>('[data-gallery-full]')!;
    const title = dialog.querySelector<HTMLElement>('#schedule-gallery-title')!;
    const buttons = [...dialog.querySelectorAll<HTMLButtonElement>('[data-gallery-track]')];
    let active = 0;
    let opener: HTMLAnchorElement | undefined;
    let previousOverflow = '';
    const showImage = (link: HTMLAnchorElement) => {
      image.alt = link.querySelector('img')?.alt ?? '';
      image.src = link.href;
      full.href = link.href;
      title.textContent = link.dataset.galleryTitle ?? '';
      dialog.scrollTop = 0;
    };
    const select = (index: number) => {
      active = (index + thumbnails.length) % thumbnails.length;
      showImage(thumbnails[active]);
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === active)));
    };
    triggers.forEach((link) => link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      opener = link;
      const index = thumbnails.indexOf(link);
      dialog.classList.toggle('kcpc-single-image', index === -1);
      dialog.classList.toggle('kcpc-wide-image', link.hasAttribute('data-gallery-wide'));
      buttons.forEach((button) => { button.hidden = index === -1; });
      if (index === -1) showImage(link);
      else select(index);
      previousOverflow = document.body.style.overflow;
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    }));
    buttons.forEach((button, index) => button.addEventListener('click', () => select(index)));
    dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
      if (opener?.hasAttribute('data-schedule-index') && (event.key === 'ArrowRight' || event.key === 'ArrowLeft')) {
        event.preventDefault(); select(active + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) {
      const box = dialog.getBoundingClientRect();
      if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
    }});
    dialog.addEventListener('close', () => { document.body.style.overflow = previousOverflow; opener?.focus(); });
  }
</script>

<style>
  .kcpc-image-card { width: min(100%, 420px); margin-inline: auto; }
  .kcpc-image-card--flyer { width: min(100%, 340px); margin-top: 12px; }
  .kcpc-afterparty-details { margin: 24px auto 0; text-align: center; }
  #schedule-gallery.kcpc-single-image { width: min(560px, 96vw); }
  #schedule-gallery.kcpc-wide-image { width: min(1040px, 96vw); }
  #schedule-gallery.kcpc-single-image img { width: auto; max-width: 100%; margin-inline: auto; }
  #schedule-gallery button[hidden] { display: none; }

  .venue-photos { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: center; gap: clamp(16px, 3vw, 32px); margin-top: 28px; }
  .venue-photos figure { min-width: 0; margin: 0; }
  .venue-photos img { display: block; width: 100%; height: auto; border-radius: 10px; }
  .venue-photos__gallery { max-width: 387px; justify-self: center; }
  .venue-photos figcaption { margin-top: 10px; font-size: .9375rem; line-height: 1.4; }
  @media (max-width: 640px) { .venue-photos { grid-template-columns: minmax(0, 1fr); } .venue-photos__gallery { width: min(100%, 320px); } }
</style>
