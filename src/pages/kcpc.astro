---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import CardGrid from "../components/CardGrid.astro";
import ImageGallery from "../components/ImageGallery.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";
import Hero from "../components/Hero.astro";

const trailblazerSponsors = [
  {
    href: "https://www.evolution-mag.com/",
    src: "/assets/images/kcpc/evolution.jpg",
    alt: "The Evolution Magazine logo",
    title: "Evolution Magazine",
  },
];

const programFocusItems = [
  {
    icon: "book",
    title: "Advancements in psychedelic science",
    body: "Research, clinical practice, and the questions shaping the field.",
  },
  {
    icon: "heart",
    title: "Integration and harm reduction",
    body: "Practical approaches to preparation, support, and aftercare.",
  },
  {
    icon: "policy",
    title: "Missouri policy efforts",
    body: "State and local conversations about access, care, and public policy.",
  },
  {
    icon: "spark",
    title: "Embodied practice",
    body: "Somatic work, meditation, movement, and body-based sessions.",
  },
];

const kcpc2025Gallery = [
  {
    src: "/assets/images/kcpc2025/kcpc-2025-16.jpg",
    alt: "KCPC 2025 exhibitor table with handmade jewelry and community materials",
    title: "Lectures & Q&A",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-07.jpg",
    alt: "Attendees moving together during a KCPC 2025 workshop",
    title: "Movement and play",
    description: "Somatic workshops, ecstatic dance, and ceremony.",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-09.jpg",
    alt: "KCPC 2025 attendees connecting near community tables",
    title: "Aligned organizations and causes",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-12.jpg",
    alt: "KCPC 2025 vendor displaying handmade jewelry and goods",
    title: "Vendor & Sponsor Exhibits",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-18.jpg",
    alt: "Audience seated for a presentation at KCPC 2025",
    title: "A space to slow down and go inward",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-19.jpg",
    alt: "KCPC 2025 attendees resting on cushions during a guided session",
    title: "Unique community discussion panels",
  },
];
---

<BaseLayout
  title="Kansas City Psychedelic Conference"
  description="Kansas City Psychedelic Conference 2026: Frontiers in Consciousness, November 21 at the Zhou B Art Center in Kansas City, featuring Dr. Rick Strassman, author of DMT: The Spirit Molecule."
>
  <Hero
    eyebrow="KCPC 2026 · Frontiers in Consciousness"
    titleLines={["Kansas City", "Psychedelic", "Conference"]}
    intro="A full day of research, conversation, and embodied practice with keynote speaker Dr. Rick Strassman."
    image="/assets/images/kcpc2025/kcpc-2025-14.jpg"
    imageAlt="Audience listening to a speaker at the 2025 Kansas City Psychedelic Conference"
  >
    <Button slot="actions" href="https://luma.com/rfkhxamw" variant="primary">Buy tickets</Button>
    <Button slot="actions" href="#event-details" variant="secondary">Event details</Button>
    <Button slot="actions" href="https://forms.gle/uPzrdhrb62ZEaLwD7" variant="secondary">Volunteer</Button>
  </Hero>

  <Section tone="paper" eyebrow="Program focus" title="Four areas shape the day." intro="A balanced program across research, public policy, integration, and embodied practice.">
    <CardGrid columns="four">
      {programFocusItems.map((item) => (
        <article class="feature-card conference-topic">
          <div class="card-icon">
            <Icon name={item.icon} />
          </div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </CardGrid>
  </Section>

  <Section id="event-details" tone="mist" eyebrow="Event details" title="Saturday, November 21, 2026" intro="Zhou B Art Center · Kansas City, MO · 9:00 AM–5:00 PM">
    <CardGrid columns="four">
      <article class="feature-card conference-topic">
        <p class="eyebrow">When</p>
        <h3>9:00 AM–5:00 PM</h3>
        <p>Full-day program.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">Where</p>
        <h3>Zhou B Art Center</h3>
        <p>Kansas City, Missouri.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">Keynote</p>
        <h3>Dr. Rick Strassman</h3>
        <p>Author of <em>DMT: The Spirit Molecule</em>.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">VIP ticket</p>
        <h3>After-party access</h3>
        <p>Included with VIP admission.</p>
      </article>
    </CardGrid>
    <div class="kcpc-cta-strip">
      <div>
        <p class="eyebrow">Tickets</p>
        <p>Tickets are available now.</p>
      </div>
      <Button href="https://luma.com/rfkhxamw" variant="primary">Buy tickets</Button>
    </div>
  </Section>

  <Section tone="ink" eyebrow="2026 theme" title="Frontiers in Consciousness">
    <CardGrid columns="three">
      <article class="feature-card conference-topic">
        <p class="eyebrow">The premise</p>
        <h3>Beyond the known</h3>
        <p>Learn about cutting-edge psychedelic science developments and discoveries.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">The conversation</p>
        <h3>Science, healing, and spirituality</h3>
        <p>Research and lived experience in the same room.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">The format</p>
        <h3>Mind and Body stages</h3>
        <p>Mind brings lectures, panels, and Q&A. Body brings somatic workshops, ecstatic dance, meditation, and ceremony.</p>
      </article>
    </CardGrid>
  </Section>

  <Section eyebrow="Keynote speaker" title="Dr. Rick Strassman" intro="Author of DMT: The Spirit Molecule and a pioneering researcher in human psychedelic studies.">
    <div class="split-band">
      <div>
        <p class="eyebrow">A long view</p>
        <p class="text-xl leading-relaxed">Dr. Strassman’s DMT studies at the University of New Mexico in the early 1990s helped reopen the door to human psychedelic research in the United States. He later wrote <em>DMT: The Spirit Molecule</em>, the landmark book that brought this work to a wider audience.</p>
      </div>
      <div>
        <p class="eyebrow">On the program</p>
        <p class="text-xl leading-relaxed">His keynote will set the tone for the day’s Mind and Body conversations, alongside psychedelic art, interactive activations, a gallery, and a raffle supporting Safe Journey Sanctum.</p>
      </div>
    </div>
  </Section>

  <Section eyebrow="KCPC 2025" title="A look back at last year." intro="Scenes from the rooms, workshops, and conversations that shaped KCPC 2025."
  >
    <ImageGallery images={kcpc2025Gallery} columns="three" />
  </Section>

  <Section eyebrow="Get involved" title="Take part in the conference." intro="Volunteer, propose a session, or support the event as a sponsor or vendor.">
    <CardGrid columns="three">
      <article class="feature-card conference-topic">
        <p class="eyebrow">Volunteer</p>
        <h3>Want to help out?</h3>
        <p>Contribute time, skills, or resources to the KCPC team.</p>
        <Button href="https://forms.gle/uPzrdhrb62ZEaLwD7" variant="secondary">Volunteer form</Button>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">Speaker and presenter</p>
        <h3>Propose a session.</h3>
        <p>Share research, practice, or a perspective with the community.</p>
        <Button href="https://docs.google.com/forms/d/1arXwo043GzglzVz6K3WAG4Ka8xV9eAXh1uDiL8GkXw4/edit?usp=drivesdk" variant="secondary">Presenter application</Button>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">Sponsor and vendor</p>
        <h3>Support the program.</h3>
        <p>Bring your organization, service, or offering to KCPC.</p>
        <Button href="https://docs.google.com/forms/d/1PZUCp2RBuPI0S_-Z9KzcsKH_P2sIAXYKfXRJ2BZFaok/edit?usp=drivesdk" variant="secondary">Sponsor and vendor</Button>
      </article>
    </CardGrid>
  </Section>

  <Section tone="mist" eyebrow="Program update" title="MIND and BODY tracks return." intro="The 2026 schedule is in development. Session times and presenters will be published when confirmed.">
    <CardGrid columns="two">
      <article class="feature-card conference-topic">
        <p class="eyebrow">MIND</p>
        <h3>Lectures, panels, and conversation.</h3>
        <p>Research, clinical practice, policy, and ideas for the future of psychedelic care.</p>
      </article>
      <article class="feature-card conference-topic">
        <p class="eyebrow">BODY</p>
        <h3>Somatic and embodied practice.</h3>
        <p>Meditation, movement, ceremony, and other body-based approaches.</p>
      </article>
    </CardGrid>
  </Section>

  <Section eyebrow="Special Thanks" title="KCPC sponsors make this possible.">
    <div class="space-y-12">
      <div>
        <h2 class="sponsor-heading">KCPC 2026 After Party Sponsor</h2>
        <ImageGallery images={trailblazerSponsors} variant="logo" />
      </div>
    </div>
  </Section>

</BaseLayout>
