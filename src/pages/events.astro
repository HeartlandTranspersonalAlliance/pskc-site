---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";
import Hero from "../components/Hero.astro";
import { exampleEvents } from "../data/exampleEvents";
import { site } from "../data/site";
import { withBase } from "../utils/urls";
---

<BaseLayout
  title="Upcoming Events"
  description="Upcoming Psychedelic Society of Kansas City events and monthly meetups."
>
  <Hero
    compact
    eyebrow="Events"
    titleLines={["Upcoming", "gatherings."]}
    intro="PSKC hosts monthly gatherings for community education, engagement, integration, and peer support across Kansas City."
    image="/assets/images/kcpcbanner.jpg"
    imageAlt="Abstract KCPC mandala artwork used for PSKC event pages"
  >
    <Button slot="actions" href={site.luma} variant="primary">Open Lu.ma Calendar</Button>
    <Button slot="actions" href={site.luma} variant="secondary">Subscribe on Lu.ma</Button>
  </Hero>

  <Section eyebrow="Calendar" title="Upcoming gatherings" intro="Monthly events are designed for learning, conversation, and community care.">
    <div class="event-mini-grid" aria-label="PSKC event focus areas">
      <a class="event-mini-card" href={site.luma} target="_blank" rel="noopener noreferrer">
        <Icon name="calendar" />
        <div>
          <h3 class="font-black">Community education and engagement</h3>
          <p>Monthly events for accessible education, conversation, and connection across Kansas City's psychedelic community.</p>
        </div>
      </a>
      <a class="event-mini-card" href={site.luma} target="_blank" rel="noopener noreferrer">
        <Icon name="users" />
        <div>
          <h3 class="font-black">Integration and peer support</h3>
          <p>A private, confidential space to share, reflect, and connect with community support.</p>
        </div>
      </a>
    </div>

    <div class="example-event-list" aria-label="Monthly event formats">
      {exampleEvents.map((event) => (
        <a class="event-list-card" href={site.luma} target="_blank" rel="noopener noreferrer" aria-label={`View PSKC events for ${event.title}`}>
          <Icon name={event.icon} />
          <div>
            <p class="eyebrow">{event.label}</p>
            <h3>{event.title}</h3>
            <p>{event.body}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="calendar-panel">
      <img
        class="calendar-panel__placeholder"
        src={withBase("/assets/images/placeholders/luma-calendar.png")}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <iframe
        class="luma-frame"
        src="https://lu.ma/embed/calendar/cal-WzYiUbVWw82gLyR/events?lt=light"
        title="Psychedelic Society of Kansas City Lu.ma events calendar"
        frameborder="0"
        allowfullscreen
        aria-hidden="false"
        tabindex="0"
      ></iframe>
    </div>
    <p class="mt-5 text-base">
      Having trouble viewing the embedded calendar?
      <a class="read-more-link" href={site.luma} target="_blank" rel="noopener noreferrer">
        Open the PSKC Lu.ma calendar.
      </a>
    </p>
  </Section>

  <Section tone="mist" eyebrow="Policy action" title="Support psychedelic access in Missouri." intro="For statewide advocacy and public policy work, follow the Psychedelic Missouri campaign and super PAC.">
    <article class="feature-card">
      <div class="card-icon"><Icon name="policy" /></div>
      <h3>Psychedelic Missouri</h3>
      <p>Learn about efforts to create legal psychedelic access for Missourians and connect with the statewide movement.</p>
      <Button href="https://www.psychedelicmissouri.com/" variant="primary">Visit Psychedelic Missouri</Button>
    </article>
  </Section>
</BaseLayout>
