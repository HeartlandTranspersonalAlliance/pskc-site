---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardGrid from "../components/CardGrid.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";
import Hero from "../components/Hero.astro";
import { site } from "../data/site";

const contactCards = [
  {
    icon: "discord",
    title: "PSKC on Discord",
    body: "Talk with other members and get local updates.",
    href: site.discord,
    action: "Join our Discord",
  },
  {
    icon: "link",
    title: "Social links and newsletter",
    body: "Follow PSKC or find the newsletter.",
    href: site.linksHub,
    action: "See social links",
  },
  {
    icon: "heart",
    title: "Donate",
    body: "Support community education, events, and harm reduction work in Kansas City.",
    href: site.donate,
    action: "Donate now",
  },
];
---

<BaseLayout
  editorial
  title="Contact Us"
  description="Email PSKC or use our contact form for questions, accessibility requests, press and partnerships."
>
  <Hero
    compact
    titleLines={["Contact PSKC"]}
    intro="Email us or use the contact form for general questions, accessibility requests, press and partnerships."
    image="/assets/images/PSKC%20FB_BANNER-01.jpeg"
    imageAlt="Kansas City skyline illustration with PSKC geometric artwork"
  />

  <Section>
    <section class="contact-form editorial-contact" aria-labelledby="contact-options">
      <h2 id="contact-options" class="contact-form__title">Send us a message</h2>
      <p>Write to <a class="editorial-email" href={`mailto:${site.email}`}>{site.email}</a> or use the form.</p>
      <a class="button button--primary" href="https://forms.gle/rrJ3TLN3XgfKAsRQ6" target="_blank" rel="noopener noreferrer">Open contact form</a>
    </section>

    <CardGrid columns="three">
      {contactCards.map((card) => (
        <a class="contact-card" href={card.href} target={card.href.startsWith("http") ? "_blank" : undefined} rel={card.href.startsWith("http") ? "noopener noreferrer" : undefined}>
          <div class="contact-card__icon">
            <Icon name={card.icon} />
          </div>
          <h2>{card.title}</h2>
          <p>{card.body}</p>
          <span class="contact-card__link">
            {card.action}
          </span>
        </a>
      ))}
    </CardGrid>

  </Section>
</BaseLayout>
