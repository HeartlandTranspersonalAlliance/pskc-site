---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";

const applications = [
  {
    id: "volunteer",
    badge: "Volunteer",
    label: "Year-round opportunities",
    title: "Volunteer with HTA",
    icon: "heart",
    description: "Help with events, education, outreach, harm reduction, or behind-the-scenes work. Tell us what you’d like to do and when you’re available. No prior experience is required to apply. Some roles have additional training or screening.",
    href: "https://forms.gle/LyxUYELDu1dEqNwh9",
    action: "Open volunteer application",
  },
  {
    id: "board",
    badge: "Board",
    label: "Governance & advisory service",
    title: "Serve on the board or advise HTA",
    icon: "policy",
    description: "Apply for a voting board seat or express interest in a non-voting advisory or committee role. The board sets strategy and oversees finances and ethics. We welcome professional, community, and lived experience. Prior board service isn’t required.",
    href: "https://forms.gle/TXoKSLAftjnpBcNP7",
    action: "Open board application",
  },
];
---

<BaseLayout
  title="Volunteer & Board Applications"
  description="Apply to volunteer with Heartland Transpersonal Alliance or express interest in board and advisory service."
  noIndex
>
  <Hero
    compact
    eyebrow="Volunteer & board applications"
    titleLines={["Get involved", "with HTA."]}
    intro="Both applications go to Heartland Transpersonal Alliance (HTA), the parent organization of the Psychedelic Society of Kansas City (PSKC), Safe Journey Sanctum (SJS), and the Kansas City Psychedelic Integration Circle (KCPIC)."
    image="/assets/images/kcpcbanner.jpg"
  />

  <Section
    tone="mist"
    eyebrow="Heartland Transpersonal Alliance"
    title="Choose your application."
    intro="Volunteer with HTA or one of its programs, or apply to help guide the organization as a board or advisory member."
  >
    <div class="application-grid">
      {applications.map(({ id, badge, label, title, icon, description, href, action }) => (
        <article class="application-card" aria-labelledby={id + "-application"}>
          <div class="application-card__badge" aria-hidden="true">
            <Icon name={icon} />
            <span>{badge}</span>
          </div>
          <div class="application-card__body">
            <p class="application-card__label">{label}</p>
            <h3 id={id + "-application"}>{title}</h3>
            <p class="application-card__description">{description}</p>
            <div class="application-card__actions">
              <Button href={href} variant="primary" ariaLabel={action + " in Google Forms (opens in a new tab)"}>
                {action} <span aria-hidden="true">↗</span>
              </Button>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="application-note">Both applications open in Google Forms.</p>
  </Section>
</BaseLayout>

<style>
  .application-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 2.1vw, 1.5rem);
  }

  .application-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: start;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: linear-gradient(145deg, var(--surface-strong), var(--surface));
    box-shadow: var(--card-shadow);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .application-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: .3rem;
    background: linear-gradient(180deg, var(--gold), var(--fern));
  }

  .application-card:nth-child(2)::before {
    background: linear-gradient(180deg, var(--cyan), var(--gold));
  }

  .application-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -5rem -5rem auto auto;
    width: 14rem;
    height: 14rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(118 183 229 / .11), transparent 70%);
    pointer-events: none;
  }

  .application-card__badge {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: .6rem;
    min-height: 8.5rem;
    padding: .65rem .25rem;
    border: 1px solid rgb(239 199 94 / .25);
    border-radius: .75rem;
    background: var(--ink);
    color: var(--gold);
    font-size: .67rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .application-card__badge :global(.icon) {
    font-size: 2.75rem;
  }

  .application-card__body {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    min-width: 0;
    align-self: stretch;
  }

  .application-card__label {
    margin-bottom: .65rem;
    color: var(--muted);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .application-card h3 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.15vw, 1.9rem);
    font-weight: 700;
    line-height: 1.14;
    text-wrap: balance;
  }

  .application-card__description {
    max-width: 55ch;
    margin-top: .8rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .application-card__actions {
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .application-card__actions :global(.button) {
    max-width: 100%;
    min-height: 44px;
    text-align: center;
  }

  .application-card__actions :global(.button:focus-visible) {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .application-note {
    margin-top: 1.75rem;
    color: var(--muted);
    font-size: .97rem;
  }

  @media (hover: hover) {
    .application-card:hover {
      border-color: rgb(239 199 94 / .55);
      box-shadow: 0 22px 48px rgb(0 0 0 / .2);
      transform: translateY(-3px);
    }
  }

  @media (min-width: 920px) {
    .application-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 580px) {
    .application-card {
      gap: .8rem;
      grid-template-columns: minmax(0, 1fr);
      padding: 1rem;
    }

    .application-card__badge {
      grid-auto-flow: column;
      justify-self: start;
      align-items: center;
      min-height: 0;
      padding-inline: .65rem;
    }

    .application-card__badge :global(.icon) {
      font-size: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .application-card {
      transition: none;
    }

    .application-card:hover {
      transform: none;
    }
  }
</style>
