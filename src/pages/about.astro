---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardGrid from "../components/CardGrid.astro";
import Icon from "../components/Icon.astro";
import ImageGallery from "../components/ImageGallery.astro";
import Section from "../components/Section.astro";
import Hero from "../components/Hero.astro";
import { withBase } from "../utils/urls";

const workCards = [
  {
    icon: "calendar",
    title: "Monthly meetups",
    body: "Guest speakers discuss topics such as clinical trials and Missouri policy. We also hear about local art projects and ways to get involved.",
  },
  {
    icon: "book",
    title: "Psychedelic education",
    body: "We share new research and historical context through our site, newsletter and social channels.",
  },
  {
    icon: "users",
    title: "Workshops and local partnerships",
    body: "We work with other groups to bring educational workshops and events to Kansas City.",
  },
];

const timeline = [
  {
    year: "2024",
    title: "PSKC starts in Kansas City",
    body: "Local organizers start PSKC to make room for public education and conversation about psychedelics.",
  },
  {
    year: "2025",
    title: "The first Kansas City Psychedelic Conference",
    body: "The conference brings local community members and visiting speakers together for talks and workshops.",
  },
  {
    year: "Now",
    title: "Meetups and member support",
    body: "PSKC continues to host monthly meetups and share public updates.",
  },
];

const pastEvents = [
  {
    src: "/assets/images/kcpc2025/kcpc-2025-20.jpg",
    alt: "Audience listening during the 2025 Kansas City Psychedelic Conference",
    title: "Kansas City Psychedelic Conference, 2025",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-16.jpg",
    alt: "Vendor and sponsor exhibits at the 2025 Kansas City Psychedelic Conference",
    title: "Vendor and sponsor exhibits",
  },
  {
    src: "/assets/images/events/tiedye-your-pride-2025.jpg",
    alt: "PSKC community members and performers posing together at the Tie-Dye Your Pride event in 2025",
    title: "Tie-Dye Your Pride, 2025",
  },
];
---

<BaseLayout
  editorial
  title="About PSKC"
  description="Learn why the Psychedelic Society of Kansas City started in 2024 and what we do locally."
>
  <Hero
    compact
    titleLines={["About PSKC"]}
    intro="We hold monthly meetups in Kansas City to talk about psychedelic research, policy and harm reduction. You don’t need a background in the field to join us."
    image="/assets/images/PSKC%20FB_BANNER-01.jpeg"
    imageAlt="Kansas City skyline illustration with PSKC geometric artwork"
  />

  <Section>
    <article class="prose-site">
      <h2>Our mission</h2>
      <p>
        We want people in Kansas City to be able to ask honest questions about psychedelics without stigma. Our gatherings make room for personal stories alongside research and give people a place to learn about harm reduction and how psychedelics are being studied in clinical settings. Members include researchers, artists, therapists, educators and people who are simply curious.
      </p>
    </article>
  </Section>

  <Section tone="mist" title="How PSKC started">
    <div class="split-media timeline-visual">
      <img src={withBase("/assets/images/bio-photo.jpg")} alt="Colorful artwork representing reflection, community care, and Kansas landscapes" loading="lazy" />
    </div>
    <div class="timeline-list">
      {timeline.map((item) => (
        <article class="timeline-card">
          <div class="timeline-year">{item.year}</div>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <Section title="What we do">
    <CardGrid columns="three">
      {workCards.map((card) => (
        <article class="feature-card">
          <div class="card-icon">
            <Icon name={card.icon} />
          </div>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))}
    </CardGrid>
  </Section>

  <Section title="Photos from past events">
    <ImageGallery images={pastEvents} columns="three" />
  </Section>
</BaseLayout>
