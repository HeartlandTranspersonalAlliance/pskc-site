---
import ChiefsRaffle from "../components/ChiefsRaffle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import CardGrid from "../components/CardGrid.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";
import Hero from "../components/Hero.astro";
import ImageGallery from "../components/ImageGallery.astro";
import { site } from "../data/site";
import { withBase } from "../utils/urls";

const pillars = [
  {
    label: "Community",
    icon: "users",
    title: "Meet people locally",
    body: "Our monthly gatherings welcome newcomers alongside advocates, artists, educators, researchers and therapists.",
  },
  {
    label: "Education",
    icon: "book",
    title: "Learn about psychedelics",
    body: "We share information about psychedelic science, policy, culture, history and clinical applications through events, newsletters and social channels.",
  },
  {
    label: "Harm Reduction",
    icon: "firstAid",
    title: "Make informed decisions",
    body: "Our public events discuss risks, legal boundaries and peer support so people can make informed decisions.",
  },
  {
    label: "Advocacy",
    icon: "advocacy",
    title: "Kansas City deserves better policy",
    body: "We support approaches to drug use and mental health informed by research and compassion.",
  },
];

const kcpc2025Gallery = [
  {
    src: "/assets/images/kcpc2025/kcpc-2025-03.jpg",
    alt: "Community members gathered in a circle at KCPC 2025",
    title: "Community conversation",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-06.jpg",
    alt: "KCPC 2025 attendees posing together after a session",
    title: "Attendees after a session",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-08.jpg",
    alt: "Movement workshop with colorful scarves at KCPC 2025",
    title: "Movement workshop",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-14.jpg",
    alt: "Audience listening to a KCPC 2025 speaker",
    title: "Speaker session",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-19.jpg",
    alt: "Attendees taking part in a floor-based workshop at KCPC 2025",
    title: "Workshop participants",
  },
  {
    src: "/assets/images/kcpc2025/kcpc-2025-21.jpg",
    alt: "Panel conversation on stage at KCPC 2025",
    title: "Panel discussion",
  },
];
---

<BaseLayout
  editorial
  title="Home"
  description="Psychedelic Society of Kansas City hosts community gatherings and education events about psychedelics, harm reduction and public policy."
>
  <Hero
    eyebrow="KCPC 2026 · Frontiers in Consciousness"
    titleLines={["Kansas City", "Psychedelic", "Conference 2026"]}
    intro="Join us November 21 at Zhou B Art Center for talks and workshops, including a live teleconference keynote by Dr. Rick Strassman."
    image="/assets/images/kcpc2025/kcpc-2025-20.jpg"
    imageAlt="Panel discussion with speakers on stage at the 2025 Kansas City Psychedelic Conference"
  >
    <Button slot="actions" href="/kcpc/" variant="primary">View conference details</Button>
    <Button slot="actions" href="https://luma.com/rfkhxamw" variant="secondary">Buy tickets</Button>
    <Button slot="actions" href="#chiefs-raffle" variant="secondary">See the raffle result</Button>
  </Hero>

  <ChiefsRaffle />

  <Section tone="mist" eyebrow="Frontiers in Consciousness" title="KCPC 2026 at Zhou B Art Center." intro="Saturday, November 21, 2026 · Doors 8:00 AM · Program 9:00 AM–6:30 PM Central · Zhou B Art Center · Kansas City, MO">
    <div class="kcpc-cta-strip">
      <div>
        <p class="eyebrow">Featured guest</p>
        <h3 class="text-3xl font-bold">Rick Strassman</h3>
        <p class="mt-2">Dr. Strassman studied DMT at the University of New Mexico in the early 1990s and wrote <em>DMT: The Spirit Molecule</em>.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href="/kcpc/#schedule" variant="primary">Conference schedule</Button>
        <Button href="https://luma.com/rfkhxamw" variant="secondary">Buy tickets</Button>
      </div>
    </div>
  </Section>

  <Section
    eyebrow="About PSKC"
    title="Meet Kansas City’s psychedelic community."
    intro="New to psychedelics or already involved? Join a local gathering to ask questions and meet people interested in the subject."
  >
    <p class="statement">
      Our gatherings cover psychedelic science and culture, public policy, and ways to keep each other safer.
    </p>
  </Section>

  <Section
    tone="mist"
    eyebrow="Pillars"
    title="What we do."
  >
    <CardGrid columns="four">
      {
        pillars.map((pillar) => (
          <article class="feature-card">
            <div class="card-icon">
              <Icon name={pillar.icon} />
            </div>
            <p class="eyebrow">{pillar.label}</p>
            <h3>{pillar.title}</h3>
            <p>{pillar.body}</p>
          </article>
        ))
      }
    </CardGrid>
  </Section>

  <Section tone="ink" eyebrow="Monthly meetups" title="Meet us at an upcoming event.">
    <div class="split-band">
      <div>
        <p class="text-xl leading-relaxed text-[var(--paper)]/85">
          Join us for monthly meetups where speakers and community members explore clinical research, drug policy, visionary art, integration, health, and culture.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/events/" variant="primary">Upcoming events</Button>
          <Button href={site.luma} variant="outline">Luma calendar</Button>
        </div>
      </div>
      <div class="split-media">
        <img src={withBase("/assets/images/PSKC%20FB_BANNER-01.jpeg")} alt="Psychedelic Society of Kansas City banner artwork" loading="lazy" />
      </div>
    </div>
  </Section>

  <Section eyebrow="KCPC 2025 · In pictures" title="Photos from KCPC 2025." intro="Talks, workshops and community gatherings from last year’s conference.">
    <ImageGallery images={kcpc2025Gallery} columns="three" />
    <div class="split-band">
      <div class="split-media">
        <img src={withBase("/assets/images/kcpc2025/kcpc-2025-15.jpg")} alt="Panel discussion at the 2025 Kansas City Psychedelic Conference" loading="lazy" />
      </div>
      <div>
        <p>KCPC returns November 21 at Zhou B Art Center. See this year’s speakers and plan your day with the Mind and Body schedules.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/kcpc/" variant="primary">Conference details</Button>
          <Button href="https://luma.com/rfkhxamw" variant="secondary">Buy tickets</Button>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
