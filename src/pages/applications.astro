---
import { withBase } from "../utils/urls";

const destination = withBase("/join/");
const canonical = new URL(destination, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <title>Volunteer &amp; Board Applications</title>
  </head>
  <body>
    <p>The applications page has moved. <a href={destination}>Open volunteer and board applications</a>.</p>
  </body>
</html>
